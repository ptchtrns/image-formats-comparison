{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
  },
  "include": ["app.ts"],
}
